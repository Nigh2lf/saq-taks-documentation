  <diagram id="pix-key-limit-arch" name="Arquitetura e repositórios">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="&lt;b&gt;Limite de chaves Pix ativas por conta — fluxo entre repositórios&lt;/b&gt;&lt;br&gt;branch feature/pix-key-active-limit (6 repos, 15/10/2026, pós-review) · regra: limite da conta (AccountBankRule.max_active_pix_keys) → senão global pix_key_max_active_per_account · 0 = sem limite" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry" /></mxCell>
<mxCell id="lane_base" value="1 · Base de dados e pacotes (pré-requisitos)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1240" height="330" as="geometry" /></mxCell>
<mxCell id="lane_cons" value="2 · Consumidores (quem insere PixKeyAccountBank) — cada um chama await ensure_account_can_add_pix_key(conta)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1240" height="470" as="geometry" /></mxCell>
<mxCell id="backend" value="&lt;b&gt;SAQ-Backend&lt;/b&gt; (Django, dono do schema)&lt;br&gt;finance/models.py: AccountBankRule.max_active_pix_keys (IntegerField null)&lt;br&gt;0492: AddField · 0493: seed GlobalParameters pix_key_max_active_per_account = &quot;0&quot; (INTEGER)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="380" height="90" as="geometry" /></mxCell>
<mxCell id="repo" value="&lt;b&gt;saq-repository 3.51.0&lt;/b&gt; (SQLAlchemy)&lt;br&gt;AccountBankRule.max_active_pix_keys&lt;br&gt;PixKeyAccountBankRepository.count_active_by_account(account_mirror_id= | account_id=)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="380" height="90" as="geometry" /></mxCell>
<mxCell id="shared" value="&lt;b&gt;saq-shared-libraries 1.57.0&lt;/b&gt;&lt;br&gt;saq_utilities/helpers/pix_key_limit.py (decisão pura): resolve_max_active_pix_keys, ensure_pix_key_limit → PixKeyLimitExceededError (400)&lt;br&gt;saq_cache_client.ensure_account_can_add_pix_key(conta): carrega regra, lê global, resolve e só conta se houver limite" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="360" height="110" as="geometry" /></mxCell>
<mxCell id="gp" value="&lt;b&gt;finance_globalparameters&lt;/b&gt;&lt;br&gt;pix_key_max_active_per_account&lt;br&gt;lido do Valkey por get_global_parameter(key, int)&lt;br&gt;editado em PUT /v3/parameters/{key} (backoffice)" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="rule" value="&lt;b&gt;AccountBankRule&lt;/b&gt; (1:1 com espelho ou bolsão)&lt;br&gt;max_active_pix_keys: NULL → usa global · 0 → sem limite&lt;br&gt;editado em PATCH /v3/accounts/rules (backoffice, campo novo no schema de request e resposta)" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="cache_dto" value="Sem campo no cache: o helper lê AccountBankRule do banco (cadastro de chave não é caminho quente; o cache só carrega regra lida por API no caminho quente, como max_amount_for_qr_code)" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="360" height="90" as="geometry" /></mxCell>
<mxCell id="e_b_r" value="mesma coluna" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="backend" target="repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_r_s" value="pin 3.51.0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repo" target="shared"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dict_inc" value="&lt;b&gt;dict-api-v3&lt;/b&gt; POST /v3/dict/key (cliente)&lt;br&gt;pix_key_include.py: depois do 409 de chave duplicada, antes do insert&lt;br&gt;estourou → 400 (PixKeyLimitExceededError)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="dict_claim" value="&lt;b&gt;dict-api-v3&lt;/b&gt; conclusão de reivindicação (cliente)&lt;br&gt;pix_key_claim_conclude.py: antes de inserir a chave reivindicada, no espelho do claim · 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="bo" value="&lt;b&gt;saq-backoffice-api&lt;/b&gt; POST /v3/pix/keys (operador)&lt;br&gt;pix_key.py: antes de chamar o DICT (include_pix_key), espelho ou bolsão&lt;br&gt;estourou → AppError 400 errors.pix_key.active_limit_reached {active_count}/{limit}&lt;br&gt;+ corrige auditoria da chave no bolsão (bug de 05/2026)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="bo_rules" value="&lt;b&gt;saq-backoffice-api&lt;/b&gt; PATCH / GET /v3/accounts/rules&lt;br&gt;schema: max_active_pix_keys (Optional[int] ≥ 0)&lt;br&gt;aplicado por exclude_unset, sem lógica extra · resposta devolve o campo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="640" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="lambda" value="&lt;b&gt;lambda-aws-manage-pix-keys-event&lt;/b&gt; (fila)&lt;br&gt;process_pix_key_creation.py: antes do DICT&lt;br&gt;app.py captura PixKeyLimitExceededError: warning e mensagem consumida (sem DLQ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="380" height="110" as="geometry" /></mxCell>
<mxCell id="alter_missing" value="&lt;b&gt;dict-api-v3&lt;/b&gt; POST /v3/dict/key alter (cliente)&lt;br&gt;pix_key_alter.py: a chave muda de conta → limite da conta de DESTINO, antes do DICT · 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="860" y="640" width="380" height="70" as="geometry" /></mxCell>
<mxCell id="pins" value="Pins subidos nos 4 consumidores: saq-repository 3.51.0 · saq-* 1.57.0&lt;br&gt;(dict-api-v3 vinha de 1.48 e a lambda de 1.46: conferir changelog)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="740" width="380" height="60" as="geometry" /></mxCell>
<mxCell id="steps" value="&lt;b&gt;Dentro de ensure_account_can_add_pix_key&lt;/b&gt;&lt;br&gt;1. rule = await conta.awaitable_attrs.account_rule · 2. global = get_global_parameter(…, int)&lt;br&gt;3. limite = resolve_max_active_pix_keys(rule, global); None → retorna sem contar&lt;br&gt;4. ativas = PixKeyAccountBankRepository().count_active_by_account(…) · 5. ensure_pix_key_limit(…)&lt;br&gt;Sem trava no banco: corrida entre contagem e insert aceita (decisão 15/10)" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="780" height="110" as="geometry" /></mxCell>
<mxCell id="e_s_dict_inc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="shared" target="dict_inc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s_dict_claim" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="shared" target="dict_claim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s_bo" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="shared" target="bo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s_lambda" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="shared" target="lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s_alter_missing" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="shared" target="alter_missing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
