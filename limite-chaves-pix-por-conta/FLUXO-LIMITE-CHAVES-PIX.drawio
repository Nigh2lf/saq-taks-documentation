  </diagram>
  <diagram id="pix-key-limit-flow" name="Fluxo de criação de chave">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="t2" value="&lt;b&gt;Criação de chave Pix — decisão do limite (ensure_account_can_add_pix_key, mesma sequência nos 5 pontos)&lt;/b&gt;&lt;br&gt;POST /v3/dict/key · alteração de vinculação (conta de destino) · conclusão de reivindicação · POST /v3/pix/keys (backoffice) · lambda manage-pix-keys-event" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="50" as="geometry" /></mxCell>
<mxCell id="start" value="&lt;b&gt;Pedido de nova chave&lt;/b&gt;&lt;br&gt;conta espelho (ou bolsão no backoffice / reivindicação)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="320" height="70" as="geometry" /></mxCell>
<mxCell id="acct_ok" value="Conta e bolsão ACTIVE?&lt;br&gt;(checagens já existentes)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="240" height="90" as="geometry" /></mxCell>
<mxCell id="acct_no" value="&lt;b&gt;400&lt;/b&gt; Account not found / AccountBank is closed&lt;br&gt;(lambda: Exception)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="260" height="70" as="geometry" /></mxCell>
<mxCell id="dup" value="Chave já ativa em alguma conta?&lt;br&gt;(só na inclusão do cliente)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="240" height="90" as="geometry" /></mxCell>
<mxCell id="dup_yes" value="&lt;b&gt;409&lt;/b&gt; This PIX key is already registered…" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="260" height="70" as="geometry" /></mxCell>
<mxCell id="load" value="&lt;b&gt;Carrega a regra da conta&lt;/b&gt;&lt;br&gt;rule = await conta.awaitable_attrs.account_rule&lt;br&gt;account_limit = rule.max_active_pix_keys (ou None sem regra)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="320" height="80" as="geometry" /></mxCell>
<mxCell id="glob" value="&lt;b&gt;Lê o global&lt;/b&gt;&lt;br&gt;get_global_parameter(&quot;pix_key_max_active_per_account&quot;, int) · HGET global_parameters no Valkey · None se não existir" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="590" width="320" height="80" as="geometry" /></mxCell>
<mxCell id="resolve" value="&lt;b&gt;resolve_max_active_pix_keys(account_limit, global_limit)&lt;/b&gt;&lt;br&gt;limite = conta se não for None, senão global&lt;br&gt;None ou ≤ 0 → sem limite (None)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="710" width="320" height="80" as="geometry" /></mxCell>
<mxCell id="has_limit" value="Há limite efetivo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="830" width="200" height="80" as="geometry" /></mxCell>
<mxCell id="count" value="&lt;b&gt;Conta chaves ativas&lt;/b&gt; (só com limite)&lt;br&gt;PixKeyAccountBankRepository().count_active_by_account(account_mirror_id= | account_id=)&lt;br&gt;SELECT COUNT(*) … WHERE is_active = 1 · sem FOR UPDATE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="950" width="320" height="80" as="geometry" /></mxCell>
<mxCell id="reached" value="ativas ≥ limite?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1070" width="200" height="80" as="geometry" /></mxCell>
<mxCell id="reject" value="&lt;b&gt;Recusa antes de tocar o DICT&lt;/b&gt;&lt;br&gt;dict-api-v3: PixKeyLimitExceededError → 400 {active_count, limit}&lt;br&gt;backoffice: AppError 400 errors.pix_key.active_limit_reached&lt;br&gt;lambda: warning + mensagem consumida (sem DLQ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="300" height="100" as="geometry" /></mxCell>
<mxCell id="dict" value="&lt;b&gt;Registra no DICT&lt;/b&gt; include_pix_key(bolsão, tipo, chave)&lt;br&gt;(backoffice e lambda chamam o DICT antes do insert; dict-api-v3 insere, dá flush e depois chama)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1200" width="320" height="80" as="geometry" /></mxCell>
<mxCell id="insert" value="&lt;b&gt;Insere PixKeyAccountBank&lt;/b&gt; is_active=True&lt;br&gt;+ auditoria (backoffice) + atualização do cache da empresa em background" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1320" width="320" height="80" as="geometry" /></mxCell>
<mxCell id="end" value="&lt;b&gt;201 / mensagem consumida&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1440" width="320" height="50" as="geometry" /></mxCell>
<mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="acct_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
