=0;entryDy=0;" edge="1" parent="1" source="infra-7" target="infra-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra-8" target="infra-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra-9" target="infra-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra-10" target="infra-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra-7" target="infra-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra-9" target="infra-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-25" value="&lt;b&gt;Ordem para destravar&lt;/b&gt;&lt;br&gt;1. RDS + usuários → secret rds → migration + seeds + operador&lt;br&gt;2. Fila + DLQ + role → config da lambda e stages no saq-ci → deploy&lt;br&gt;3. Tags v0.1.0 → CodeArtifact → build das APIs → manifests → deploy&lt;br&gt;4. Completar apps-configs-mexico com URL da fila e host do backoffice" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="620" height="100" as="geometry"/></mxCell><mxCell id="infra-26" value="&lt;b&gt;Local hoje&lt;/b&gt; (mexico-apps/): docker-compose com MySQL 3308 + LocalStack 4566, venv com libs SaQ do clone, collection Postman. Fluxo validado até a Fintoc em 22/10/2026." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="500" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>