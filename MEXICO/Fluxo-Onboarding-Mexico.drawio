<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="fluxo" name="1. Fluxo de onboarding"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="fluxo-1" value="&lt;b&gt;México — onboarding com abertura de conta na Fintoc&lt;/b&gt;&lt;br&gt;Como está implementado na branch feature/mexico-onboarding-schema. Atualizado em 22/10/2026." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="45" as="geometry"/></mxCell><mxCell id="fluxo-2" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="15" width="100" height="20" as="geometry"/></mxCell><mxCell id="fluxo-3" value="Cliente / portal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180" y="40" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-4" value="mexico-api-v3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1355" y="40" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-5" value="Operador / backoffice" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1530" y="40" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-6" value="Fila SQS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1"><mxGeometry x="1705" y="40" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-7" value="Lambda onboarding" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="68" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-8" value="Fintoc" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1355" y="68" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-9" value="Banco MEXICO" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1530" y="68" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-10" value="Erro / reprovação" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1705" y="68" width="165" height="22" as="geometry"/></mxCell><mxCell id="fluxo-11" value="Cliente (portal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1840" height="110" as="geometry"/></mxCell><mxCell id="fluxo-12" value="mexico-api-v3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1840" height="130" as="geometry"/></mxCell><mxCell id="fluxo-13" value="Operador no mexico-backoffice-api" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="1840" height="180" as="geometry"/></mxCell><mxCell id="fluxo-14" value="SQS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1840" height="90" as="geometry"/></mxCell><mxCell id="fluxo-15" value="lambda-aws-mexico-onboarding-approve-event" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1840" height="230" as="geometry"/></mxCell><mxCell id="fluxo-16" value="Fintoc (sandbox)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1840" height="100" as="geometry"/></mxCell><mxCell id="fluxo-17" value="Banco MEXICO (MySQL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1840" height="130" as="geometry"/></mxCell><mxCell id="fluxo-18" value="Preenche o pedido:&lt;br&gt;tipo (INDIVIDUAL / COMPANY), RFC, nome, e-mail, telefone" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="135" width="230" height="60" as="geometry"/></mxCell><mxCell id="fluxo-19" value="Recebe id do pedido + access_token&lt;br&gt;(o token só aparece aqui)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="135" width="220" height="60" as="geometry"/></mxCell><mxCell id="fluxo-20" value="Acompanha: GET /v3/onboarding/{id}&lt;br&gt;header X-Onboarding-Token" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020" y="135" width="230" height="60" as="geometry"/></mxCell><mxCell id="fluxo-21" value="Vê PENDING → APPROVED → COMPLETED&lt;br&gt;(ERROR aparece como APPROVED;&lt;br&gt;REPROVED traz o motivo)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="250" height="70" as="geometry"/></mxCell><mxCell id="fluxo-22" value="POST /v3/onboarding/&lt;br&gt;valida RFC (formato por tipo), e-mail, telefone (DDI 52)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="265" width="230" height="60" as="geometry"/></mxCell><mxCell id="fluxo-23" value="RFC já tem pedido?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="150" height="90" as="geometry"/></mxCell><mxCell id="fluxo-24" value="PENDING / APPROVED / ERROR:&lt;br&gt;devolve o mesmo pedido (200)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="190" height="45" as="geometry"/></mxCell><mxCell id="fluxo-25" value="COMPLETED: 400&lt;br&gt;already_completed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="660" y="305" width="190" height="40" as="geometry"/></mxCell><mxCell id="fluxo-26" value="Cria o pedido PENDING&lt;br&gt;grava só o SHA-256 do token → 201" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="265" width="220" height="60" as="geometry"/></mxCell><mxCell id="fluxo-27" value="Consulta pelo id + token&lt;br&gt;(token errado ou ausente: 404)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1130" y="265" width="220" height="60" as="geometry"/></mxCell><mxCell id="fluxo-28" value="Login em 2 passos:&lt;br&gt;e-mail + senha → token 2 min → TOTP → access 60 min" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="400" width="260" height="55" as="geometry"/></mxCell><mxCell id="fluxo-29" value="Lista / detalhe do pedido&lt;br&gt;(policy mexico:backoffice:onboarding:read)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="240" height="55" as="geometry"/></mxCell><mxCell id="fluxo-30" value="Decisão do operador" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="790" y="385" width="150" height="85" as="geometry"/></mxCell><mxCell id="fluxo-31" value="Reprovar com motivo&lt;br&gt;→ REPROVED (final)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="990" y="395" width="180" height="45" as="geometry"/></mxCell><mxCell id="fluxo-32" value="Aprovar → APPROVED (commit)&lt;br&gt;e só então publica na fila&lt;br&gt;(falha na fila: 503, pedido fica APPROVED)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="990" y="455" width="250" height="60" as="geometry"/></mxCell><mxCell id="fluxo-33" value="Reenviar (ERROR ou APPROVED)&lt;br&gt;→ APPROVED, mantém error_reason, republica" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="455" width="260" height="60" as="geometry"/></mxCell><mxCell id="fluxo-34" value="mexico-onboarding-approve&lt;br&gt;{&quot;onboarding_requisition_id&quot;: &quot;&lt;uuid&gt;&quot;}&lt;br&gt;DLQ com maxReceiveCount 3 · visibilidade &gt; 120 s" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1"><mxGeometry x="990" y="580" width="320" height="60" as="geometry"/></mxCell><mxCell id="fluxo-35" value="mexico-onboarding-completed (opcional)&lt;br&gt;{&quot;type&quot;: &quot;ONBOARDING_COMPLETED&quot;}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1"><mxGeometry x="1500" y="580" width="300" height="60" as="geometry"/></mxCell><mxCell id="fluxo-36" value="Pedido está APPROVED?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="200" y="675" width="170" height="80" as="geometry"/></mxCell><mxCell id="fluxo-37" value="Não (inexistente, REPROVED, COMPLETED):&lt;br&gt;consome e ignora" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="790" width="230" height="45" as="geometry"/></mxCell><mxCell id="fluxo-38" value="&lt;b&gt;Etapa 1&lt;/b&gt; · trava o pedido;&lt;br&gt;cria mx_company (ACTIVE) + mx_account (PENDING)&lt;br&gt;[commit]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="675" width="260" height="65" as="geometry"/></mxCell><mxCell id="fluxo-39" value="&lt;b&gt;Etapa 2&lt;/b&gt; · POST /v2/accounts&lt;br&gt;Idempotency-Key = mx:account:create:&lt;uuid&gt;&lt;br&gt;description = &quot;&lt;nome&gt; &lt;RFC&gt;&quot;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="675" width="270" height="65" as="geometry"/></mxCell><mxCell id="fluxo-40" value="Grava fintoc_account_id, CLABE&lt;br&gt;e mx_account = ACTIVE [commit]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1030" y="675" width="220" height="65" as="geometry"/></mxCell><mxCell id="fluxo-41" value="&lt;b&gt;Etapa 3&lt;/b&gt; · mx_user web do titular (sem senha,&lt;br&gt;flow_change_password) + mx_userrole Cliente:web&lt;br&gt;pedido = COMPLETED [commit]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1290" y="675" width="300" height="65" as="geometry"/></mxCell><mxCell id="fluxo-42" value="429 / rede / banco: exceção →&lt;br&gt;mensagem volta à fila (até 3 entregas)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="770" width="270" height="45" as="geometry"/></mxCell><mxCell id="fluxo-43" value="Outro erro da Fintoc (inclusive 5xx), RFC já cliente,&lt;br&gt;e-mail em uso, role ausente → ERROR + error_reason" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="825" width="300" height="50" as="geometry"/></mxCell><mxCell id="fluxo-44" value="Reprocessamento retoma de onde parou:&lt;br&gt;company já existe (UNIQUE), mx_account já tem fintoc_account_id" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1030" y="790" width="300" height="50" as="geometry"/></mxCell><mxCell id="fluxo-45" value="Cria a Account debaixo da Entity raiz da QAS&lt;br&gt;Nasce &lt;b&gt;active&lt;/b&gt; e já vem com a CLABE raiz&lt;br&gt;(sem passo de ativação; sem KYC do cliente final)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="915" width="330" height="65" as="geometry"/></mxCell><mxCell id="fluxo-46" value="Reenvio ou PENDING há &gt; 23 h:&lt;br&gt;lista Accounts e procura pela description antes de criar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1080" y="915" width="300" height="65" as="geometry"/></mxCell><mxCell id="fluxo-47" value="mx_onboardingrequisition" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="1040" width="180" height="70" as="geometry"/></mxCell><mxCell id="fluxo-48" value="mx_company&lt;br&gt;mx_account" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="1040" width="160" height="70" as="geometry"/></mxCell><mxCell id="fluxo-49" value="mx_user · mx_userrole&lt;br&gt;mx_role (seed)" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1290" y="1040" width="180" height="70" as="geometry"/></mxCell><mxCell id="fluxo-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fluxo-18" target="fluxo-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fluxo-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fluxo-22" target="fluxo-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fluxo-52" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;e