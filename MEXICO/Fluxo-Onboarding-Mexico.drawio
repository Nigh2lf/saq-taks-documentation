rget="fluxo-35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="707"/></Array></mxGeometry></mxCell><mxCell id="fluxo-74" value="falha temporária" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-39" target="fluxo-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fluxo-75" value="falha definitiva" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-39" target="fluxo-43"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="755"/><mxPoint x="945" y="755"/><mxPoint x="945" y="825"/></Array></mxGeometry></mxCell><mxCell id="fluxo-76" value="volta à fila" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-42" target="fluxo-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="792"/><mxPoint x="1010" y="650"/><mxPoint x="960" y="650"/><mxPoint x="960" y="610"/></Array></mxGeometry></mxCell><mxCell id="fluxo-77" value="operador reenvia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-43" target="fluxo-33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="850"/><mxPoint x="1040" y="760"/><mxPoint x="1270" y="760"/><mxPoint x="1270" y="485"/></Array></mxGeometry></mxCell><mxCell id="fluxo-78" value="antes de criar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-46" target="fluxo-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fluxo-79" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-38" target="fluxo-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fluxo-80" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-41" target="fluxo-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fluxo-81" value="UPDATE COMPLETED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-41" target="fluxo-47"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="1075"/></Array></mxGeometry></mxCell><mxCell id="fluxo-82" value="&lt;b&gt;Por que três commits&lt;/b&gt;&lt;br&gt;Cada etapa grava antes de seguir. Se a lambda morrer no meio, a próxima entrega encontra o que já existe e retoma. A chave de idempotência da Fintoc vale 24 h; no reenvio ela usa uma chave nova e procura a conta pela description, que é única por causa do RFC." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1165" width="620" height="80" as="geometry"/></mxCell><mxCell id="fluxo-83" value="&lt;b&gt;Sandbox local&lt;/b&gt;&lt;br&gt;O approve só publica na fila do LocalStack; nada consome. A lambda roda à mão: python test.py &lt;id&gt;. Na AWS a SQS dispara a lambda." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="1165" width="480" height="80" as="geometry"/></mxCell><mxCell id="fluxo-84" value="&lt;b&gt;Depois do COMPLETED&lt;/b&gt;&lt;br&gt;O usuário web nasce sem senha. Falta a rota de definir senha no mexico-api-v3 e o e-mail com o link (gancho: evento ONBOARDING_COMPLETED)." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160" y="1165" width="480" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="estados" name="2. Estados do pedido"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="estados-1" value="&lt;b&gt;Estados de mx_onboardingrequisition&lt;/b&gt;&lt;br&gt;Quem muda cada estado e o que o cliente enxerga." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="700" height="45" as="geometry"/></mxCell><mxCell id="estados-2" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;criado pela api-v3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="180" height="60" as="geometry"/></mxCell><mxCell id="estados-3" value="&lt;b&gt;APPROVED&lt;/b&gt;&lt;br&gt;operador aprovou; mensagem na fila" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="220" height="60" as="geometry"/></mxCell><mxCell id="estados-4" value="&lt;b&gt;COMPLETED&lt;/b&gt;&lt;br&gt;conta na Fintoc + CLABE + usuário web" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="220" width="240" height="60" as="geometry"/></mxCell><mxCell id="estados-5" value="&lt;b&gt;REPROVED&lt;/b&gt;&lt;br&gt;com rejection_reason (final)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="estados-6" value="&lt;b&gt;ERROR&lt;/b&gt;&lt;br&gt;com error_reason; cliente vê APPROVED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="400" width="240" height="60" as="geometry"/></mxCell><mxCell id="estados-7" value="approve (backoffice)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="estados-2" target="estados-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-8" value="reject (backoffice)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-2" target="estados-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="430"/></Array></mxGeometry></mxCell><mxCell id="estados-9" value="lambda concluiu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="estados-3" target="estados-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-10" value="lambda: erro definitivo ou 3ª entrega falhou" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-3" target="estados-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="340"/><mxPoint x="800" y="340"/></Array></mxGeometry></mxCell><mxCell id="estados-11" value="resend (backoffice), mantém error_reason" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-6" target="estados-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="430"/></Array></mxGeometry></mxCell><mxCell id="estados-12" value="resend: republica (idempotente)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-3" target="estados-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="170"/><mxPoint x="545" y="170"/></Array></mxGeometry></mxCell><mxCell id="estados-13" value="&lt;b&gt;Visão do cliente&lt;/b&gt; (GET com X-Onboarding-Token): PENDING, APPROVED, COMPLETED ou REPROVED com motivo. ERROR é interno e aparece como APPROVED." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="500" height="60" as="geometry"/></mxCell><mxCell id="estados-14" value="&lt;b&gt;Novo pedido para o mesmo RFC&lt;/b&gt;: PENDING, APPROVED ou ERROR devolvem o pedido existente; COMPLETED recusa (400); REPROVED permite criar outro." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="520" width="500" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="infra" name="3. Infra do sandbox (AWS nonprod)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="infra-1" value="&lt;b&gt;Infra do sandbox na conta nonprod da SaQ (741254594040, us-east-1)&lt;/b&gt;&lt;br&gt;Identificador do projeto: &lt;b&gt;mexico&lt;/b&gt;. Nada aqui acessa o core da SaQ. Verde = já existe · amarelo = a criar." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="50" as="geometry"/></mxCell><mxCell id="infra-2" value="EKS · mexico-apps/mexico-api-v3&lt;br&gt;(manifests + ECR a criar)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=