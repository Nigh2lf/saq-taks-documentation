le="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="spei-in-54" target="spei-in-55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="estados" name="2. Estados"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="estados-1" value="&lt;b&gt;Estados do SPEI IN&lt;/b&gt;&lt;br&gt;Inbox do webhook (mx_fintocwebhookevent) e lançamento (mx_transaction SPEI_IN). Quem muda cada estado e quando. Proposta de 30/10/2026." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="45" as="geometry"/></mxCell><mxCell id="estados-2" value="&lt;b&gt;mx_fintocwebhookevent (inbox)&lt;/b&gt;" style="text;align=left;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="400" height="25" as="geometry"/></mxCell><mxCell id="estados-3" value="RECEIVED&lt;br&gt;receptor gravou e enfileirou" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="200" height="60" as="geometry"/></mxCell><mxCell id="estados-4" value="PROCESSED&lt;br&gt;lambda creditou (ou já estava creditado)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="260" height="60" as="geometry"/></mxCell><mxCell id="estados-5" value="IGNORED&lt;br&gt;tipo de evento não tratado na V0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="260" height="60" as="geometry"/></mxCell><mxCell id="estados-6" value="ERROR&lt;br&gt;conta inexistente / bloqueada / erro definitivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="260" height="60" as="geometry"/></mxCell><mxCell id="estados-7" value="DLQ&lt;br&gt;3 entregas com exceção (429, rede, banco)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="200" height="60" as="geometry"/></mxCell><mxCell id="estados-8" value="sucesso ou duplicado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-3" target="estados-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-9" value="outro tipo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-3" target="estados-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-10" value="falha definitiva" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-3" target="estados-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-11" value="falha temporária ×3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="estados-3" target="estados-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-12" value="operador reprocessa&lt;br&gt;(backoffice)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="estados-6" target="estados-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="350"/><mxPoint x="790" y="150"/></Array></mxGeometry></mxCell><mxCell id="estados-13" value="Duplicado = mesmo event_id (receptor) ou mesma transfer.id já em mx_transaction (lambda). Nos dois casos a resposta é 200 e nada muda no saldo (RN-013)." style="text;align=left;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="640" height="40" as="geometry"/></mxCell><mxCell id="estados-14" value="&lt;b&gt;mx_transaction SPEI_IN&lt;/b&gt;" style="text;align=left;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="400" height="25" as="geometry"/></mxCell><mxCell id="estados-15" value="SUCCEEDED&lt;br&gt;criado já liquidado (a Fintoc só avisa depois de cair)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="260" height="60" as="geometry"/></mxCell><mxCell id="estados-16" value="RETURN_PENDING&lt;br&gt;devolução pedida (Return a transfer)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1000" y="230" width="260" height="60" as="geometry"/></mxCell><mxCell id="estados-17" value="RETURNED&lt;br&gt;webhook de devolução confirmado;&lt;br&gt;débito do líquido e estorno da tarifa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="260" height="70" as="geometry"/></mxCell><mxCell id="estados-18" value="produto / backoffice decide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="estados-15" target="estados-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="estados-16" target="estados-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="estados-20" value="Não existe PENDING no SPEI IN: ao contrário do Pix, não há etapa de validação antes da liquidação. Devolução é escopo em aberto (PS03)." style="text;align=left;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="premissas" name="3. Premissas e decisões em aberto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="premissas-1" value="&lt;b&gt;SPEI IN — premissas assumidas no fluxo e o que ainda precisa ser decidido&lt;/b&gt;&lt;br&gt;30/10/2026." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="45" as="geometry"/></mxCell><mxCell id="premissas-2" value="&lt;b&gt;Premissas&lt;/b&gt;" style="text;align=left;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="300" height="25" as="geometry"/></mxCell><mxCell id="premissas-3" value="Padrão B: uma Account Fintoc por cliente; o webhook traz data.account_id e é por ele que achamos a mx_account." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-4" value="O dinheiro já está liquidado quando o webhook chega. O fluxo só registra, credita e notifica; não há como recusar antes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="177" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-5" value="Idempotência em duas camadas: event_id na inbox (receptor) e transfer.id UNIQUE em mx_transaction (lambda), mais a chave Lua no Valkey." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="239" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-6" value="Receptor burro: valida HMAC, grava, enfileira, responde 200. Regra de negócio só na lambda (modelo Pix: tudo por fila, reprocessável)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="301" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-7" value="Lançamento bruto + linha de tarifa separada, com snapshot da configuração (RN-029, RN-031). Crédito no Valkey é o líquido." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="363" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-8" value="mx_transaction particionada por mês e sem FK (call de alinhamento 26/10). PK UUID, amount em centavos + currency." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-9" value="Tarifa é calculada na SaQ; o Transfer para a Account de receita da QAS é passo posterior e não bloqueia o crédito." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="487" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-10" value="Webhook ao cliente copia o motor da SaQ (fila por tipo, HMAC, 3 tentativas, log). Falha de entrega não desfaz o crédito (RN-055)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="549" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-11" value="&lt;b&gt;Decisões em aberto&lt;/b&gt;" style="text;align=left;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="300" height="25" as="geometry"/></mxCell><mxCell id="premissas-12" value="Onde fica o receptor do webhook: integration-mx (molde integration-jdpi) ou rota no mexico-api-v3. URL pública e allowlist de IP no Dashboard." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="115" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-13" value="Cobrança de 72 h: CLABE dedicada por cobrança (/v2/account_numbers com min/max_amount e metadata) ou CLABE raiz + referência? Pagamento após expirar: devolve ou credita?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="177" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-14" value="Fonte de verdade do saldo: Valkey + mx_transaction (padrão SaQ) ou available_balance da Fintoc. Conciliação por /v2/movements." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="239" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-15" value="Tarifa: por operação (um Transfer a cada SPEI, consome os 10 req/s) ou varredura diária. Confirmar se Transfer entre Accounts tem custo. Criar a Account de receita." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="301" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-16" value="Conta BLOCKED/CLOSED que recebe: devolver (Return a transfer), creditar e bloquear, ou segurar? Desativar a CLABE com PATCH account_numbers status=disabled." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="363" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-17" value="Catálogo de webhooks ao cliente (PS07): SPEI_IN_RECEIVED é o primeiro; payload, retentativa e DLQ." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="425" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-18" value="Devolução de SPEI IN (PS03): quem pede, prazo, efeito no extrato e na tarifa já cobrada." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="487" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-19" value="Limites e estados da conta (PS02): limite por recebimento (options.max_amount na CLABE) e por período." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="780" y="549" width="680" height="52" as="geometry"/></mxCell><mxCell id="premissas-20" value="&lt;b&gt;Pré-requisitos de infra (conta qasmexhml)&lt;/b&gt;: montar credenciais-partner no SecretProviderClass dos pods que chamam a Fintoc; secret do HMAC do webhook; endpoint e senha do Valkey qasmexhml-memorydb em secret/env (hoje ninguém usa); filas mexico-fintoc-webhook e mexico-company-notification (ou reaproveitar as do template); Valkey no docker-compose local." style="text;align=left;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
