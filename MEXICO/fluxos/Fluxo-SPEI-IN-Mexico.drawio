<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="spei-in" name="1. Fluxo SPEI IN"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="spei-in-1" value="&lt;b&gt;México — SPEI IN (recebimento na CLABE do cliente)&lt;/b&gt;&lt;br&gt;Proposta de fluxo, nada implementado ainda. Fontes: tarefas/SPEI/README.md, entendimento/OperacaoMexico.md e o Pix IN da SaQ (lambda-aws-pix-webhook-event / process_pix_cashin_pix_key.py). 30/10/2026." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1100" height="45" as="geometry"/></mxCell><mxCell id="spei-in-2" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="15" width="100" height="20" as="geometry"/></mxCell><mxCell id="spei-in-3" value="Pagador / banco de origem" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180" y="40" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-4" value="Fintoc" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1320" y="40" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-5" value="Receptor do webhook" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1460" y="40" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-6" value="Fila SQS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1"><mxGeometry x="1600" y="40" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-7" value="Lambda" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1740" y="40" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-8" value="Valkey (saldo mx:)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="1180" y="68" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-9" value="Banco QASMEXHML" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1320" y="68" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-10" value="Cliente / notificação" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1460" y="68" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-11" value="Erro" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1600" y="68" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-12" value="A decidir" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1740" y="68" width="130" height="22" as="geometry"/></mxCell><mxCell id="spei-in-13" value="Pagador (qualquer banco do SPEI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1840" height="90" as="geometry"/></mxCell><mxCell id="spei-in-14" value="Fintoc — Business Accounts API v2 (padrão B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="1840" height="130" as="geometry"/></mxCell><mxCell id="spei-in-15" value="Receptor do webhook Fintoc — HTTP público (integration-mx/apps/fintoc-webhook-api ou mexico-api-v3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1840" height="170" as="geometry"/></mxCell><mxCell id="spei-in-16" value="SQS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1840" height="80" as="geometry"/></mxCell><mxCell id="spei-in-17" value="lambda-aws-mexico-spei-in-event (a criar; molde: lambda-aws-mexico-onboarding-approve-event)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1840" height="230" as="geometry"/></mxCell><mxCell id="spei-in-18" value="Valkey qasmexhml-memorydb — saldo com prefixo mx: (scripts Lua copiados do saq-cache-client)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1840" height="90" as="geometry"/></mxCell><mxCell id="spei-in-19" value="Banco QASMEXHML (MySQL) — tabelas tocadas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1840" height="100" as="geometry"/></mxCell><mxCell id="spei-in-20" value="Notificação ao cliente — lambda-aws-mexico-company-notification-event (molde SaQ) + portal / API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="1070" width="1840" height="120" as="geometry"/></mxCell><mxCell id="spei-in-21" value="Faz um SPEI para a CLABE do cliente&lt;br&gt;(CLABE raiz da mx_account ou&lt;br&gt;CLABE dedicada de cobrança)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="125" width="250" height="60" as="geometry"/></mxCell><mxCell id="spei-in-22" value="Recebe o comprovante (CEP) no banco dele.&lt;br&gt;A QAS recebe o link em receipt_url" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="290" height="50" as="geometry"/></mxCell><mxCell id="spei-in-23" value="Banxico liquida na &lt;b&gt;Account do cliente&lt;/b&gt;&lt;br&gt;available_balance += valor &lt;b&gt;bruto&lt;/b&gt;&lt;br&gt;&lt;b&gt;Sem validação síncrona&lt;/b&gt;: não há “posso creditar?” como no Pix" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="200" y="230" width="250" height="90" as="geometry"/></mxCell><mxCell id="spei-in-24" value="Webhook &lt;b&gt;transfer.inbound.succeeded&lt;/b&gt;&lt;br&gt;header Fintoc-Signature (HMAC SHA-256: t=…, v1=…)&lt;br&gt;data: id tr_…, account_id, account_number{id, metadata},&lt;br&gt;amount (centavos), currency MXN, tracking_key (clave de rastreo),&lt;br&gt;reference_id, counterparty, receipt_url" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="480" y="220" width="370" height="110" as="geometry"/></mxCell><mxCell id="spei-in-25" value="Sem 2xx a Fintoc reenvia.&lt;br&gt;Eventos podem repetir e chegar fora de ordem" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="890" y="245" width="230" height="60" as="geometry"/></mxCell><mxCell id="spei-in-26" value="Tarifa sai da Account do cliente para a Account&lt;br&gt;de receita da QAS por &lt;b&gt;Transfer&lt;/b&gt; (10 req/s)&lt;br&gt;por operação ou varredura diária: &lt;b&gt;a decidir&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1580" y="235" width="260" height="80" as="geometry"/></mxCell><mxCell id="spei-in-27" value="Onde fica o receptor e a URL pública&lt;br&gt;cadastrada no Dashboard da Fintoc: &lt;b&gt;a decidir&lt;/b&gt;.&lt;br&gt;Secret do HMAC em credenciais-partner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="200" y="370" width="250" height="70" as="geometry"/></mxCell><mxCell id="spei-in-28" value="POST /webhooks/fintoc&lt;br&gt;valida Fintoc-Signature com o secret&lt;br&gt;e a tolerância de tempo do t" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="370" width="250" height="60" as="geometry"/></mxCell><mxCell id="spei-in-29" value="Assinatura válida?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="365" width="140" height="70" as="geometry"/></mxCell><mxCell id="spei-in-30" value="401, não grava nada" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="140" height="40" as="geometry"/></mxCell><mxCell id="spei-in-31" value="INSERT na inbox mx_fintocwebhookevent&lt;br&gt;(event_id UNIQUE, tipo, payload bruto,&lt;br&gt;status RECEIVED) [commit]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="930" y="370" width="260" height="60" as="geometry"/></mxCell><mxCell id="spei-in-32" value="event_id já existia?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="365" width="140" height="70" as="geometry"/></mxCell><mxCell id="spei-in-33" value="200 e encerra&lt;br&gt;(duplicado — RN-013)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1220" y="460" width="140" height="40" as="geometry"/></mxCell><mxCell id="spei-in-34" value="Publica {event_id} na fila e responde &lt;b&gt;200&lt;/b&gt;&lt;br&gt;Nenhuma regra de negócio aqui:&lt;br&gt;o receptor só autentica, guarda e enfileira" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="370" width="250" height="60" as="geometry"/></mxCell><mxCell id="spei-in-35" value="mexico-fintoc-webhook  {&amp;quot;event_id&amp;quot;: &amp;quot;&amp;lt;uuid&amp;gt;&amp;quot;}&lt;br&gt;DLQ · maxReceive 3 · visibilidade 180 s" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1"><mxGeometry x="1390" y="545" width="250" height="50" as="geometry"/></mxCell><mxCell id="spei-in-36" value="Lê o evento na inbox pelo event_id.&lt;br&gt;Tipo ≠ transfer.inbound.succeeded →&lt;br&gt;marca IGNORED e encerra" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="200" y="645" width="230" height="60" as="geometry"/></mxCell><mxCell id="spei-in-37" value="Busca mx_account por&lt;br&gt;fintoc_account_id = data.account_id&lt;br&gt;(FOR UPDATE)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="645" width="230" height="60" as="geometry"/></mxCell><mxCell id="spei-in-38" value="Conta existe&lt;br&gt;e ACTIVE?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="640" width="150" height="70" as="geometry"/></mxCell><mxCell id="spei-in-39" value="mx_transaction já tem&lt;br&gt;fintoc_transfer_id = data.id? (UNIQUE)&lt;br&gt;sim → evento PROCESSED e encerra (RN-013)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="645" width="250" height="60" as="geometry"/></mxCell><mxCell id="spei-in-40" value="Calcula a tarifa vigente da conta&lt;br&gt;(VALUE / PERCENT_WITH_MIN / _MIN_AND_MAX).&lt;br&gt;Sem tarifa cadastrada não é isenção (RN-032)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="645" width="250" height="60" as="geometry"/></mxCell><mxCell id="spei-in-41" value="&lt;b&gt;Etapa 1&lt;/b&gt; [commit] · mx_transaction SPEI_IN com o valor &lt;b&gt;bruto&lt;/b&gt;, status SUCCEEDED,&lt;br&gt;uuid = transfer.id, tracking_key, reference_id, pagador, receipt_url&lt;br&gt;+ linha SPEI_IN_TAX com a tarifa e o snapshot da configuração (RN-029 / RN-031)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1460" y="640" width="380" height="70" as="geometry"/></mxCell><mxCell id="spei-in-42" value="&lt;b&gt;Etapa 2&lt;/b&gt; · credita o &lt;b&gt;líquido&lt;/b&gt; (bruto − tarifa) no Valkey&lt;br&gt;Lua cashin_credit, chave mx:{account:&amp;lt;id&amp;gt;}:cashin:credit:&amp;lt;transfer.id&amp;gt;&lt;br&gt;(se a chave já existe, não soma de novo)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1460" y="750" width="380" height="60" as="geometry"/></mxCell><mxCell id="spei-in-43" value="&lt;b&gt;Etapa 3&lt;/b&gt; [commit] · evento PROCESSED;&lt;br&gt;publica SPEI_IN_RECEIVED;&lt;br&gt;metadata.charge_id → mx_charge PAID" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="750" width="250" height="60" as="geometry"/></mxCell><mxCell id="spei-in-44" value="não: evento ERROR + registro em&lt;br&gt;mx_reconciliationissue (RN-066).&lt;br&gt;O dinheiro já está na Account Fintoc;&lt;br&gt;devolver = “Return a transfer” (produto decide)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="745" width="230" height="70" as="geometry"/></mxCell><mxCell id="spei-in-45" value="429 / rede / banco: exceção →&lt;br&gt;mensagem volta à fila mexico-fintoc-webhook&lt;br&gt;(até 3 entregas) → DLQ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="200" y="750" width="230" height="60" as="geometry"/></mxCell><mxCell id="spei-in-46" value="Reprocessamento retoma de onde parou:&lt;br&gt;transação já existe (UNIQUE) → só repete&lt;br&gt;o crédito idempotente e a notificação" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="750" width="230" height="60" as="geometry"/></mxCell><mxCell id="spei-in-47" value="mx:{account:&amp;lt;id&amp;gt;}:balance&lt;br&gt;+= líquido" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="1460" y="870" width="170" height="75" as="geometry"/></mxCell><mxCell id="spei-in-48" value="mx:{account:&amp;lt;id&amp;gt;}:cashin:credit:&amp;lt;transfer.id&amp;gt;&lt;br&gt;marca de idempotência (TTL)" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="1650" y="870" width="190" height="75" as="geometry"/></mxCell><mxCell id="spei-in-49" value="mx_accounttariff&lt;br&gt;(tarifa vigente ← Etapa 1)&lt;br&gt;mx_charge (cobrança 72 h ← Etapa 3)" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="975" width="230" height="70" as="geometry"/></mxCell><mxCell id="spei-in-50" value="mx_account&lt;br&gt;(fintoc_account_id UNIQUE)" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="975" width="230" height="70" as="geometry"/></mxCell><mxCell id="spei-in-51" value="mx_fintocwebhookevent — inbox&lt;br&gt;(event_id UNIQUE; RECEIVED → PROCESSED / IGNORED / ERROR)" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="975" width="430" height="70" as="geometry"/></mxCell><mxCell id="spei-in-52" value="mx_transaction (particionada por mês, sem FK)&lt;br&gt;SPEI_IN bruto + SPEI_IN_TAX · uuid = transfer.id UNIQUE" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1460" y="975" width="380" height="70" as="geometry"/></mxCell><mxCell id="spei-in-53" value="SQS mexico-company-notification&lt;br&gt;{type: SPEI_IN_RECEIVED, transaction_id, account_id}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1"><mxGeometry x="1180" y="1090" width="250" height="50" as="geometry"/></mxCell><mxCell id="spei-in-54" value="Lambda lê mx_webhook da conta para SPEI_IN_RECEIVED;&lt;br&gt;POST com header hmac (hmac_key do cliente), timeout 5 s,&lt;br&gt;3 tentativas e log de entrega (RN-054 a RN-056)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1460" y="1085" width="380" height="65" as="geometry"/></mxCell><mxCell id="spei-in-55" value="Cliente recebe o webhook e vê no portal / API&lt;br&gt;GET statement: SPEI_IN (bruto) e SPEI_IN_TAX,&lt;br&gt;saldo disponível atualizado (RN-012, RN-034)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="1085" width="430" height="65" as="geometry"/></mxCell><mxCell id="spei-in-56" value="SPEI via Banxico" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="spei-in-21" target="spei-in-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="spei-in-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spei-in-23" target="spei-in-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="spei-in-58" value="CEP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="spei-in-24" target="spei-in-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="spei-in-59" valu