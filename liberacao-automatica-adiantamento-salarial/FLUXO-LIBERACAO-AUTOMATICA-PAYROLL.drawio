  <diagram id="payroll-auto-release" name="Liberação automática">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Antecipação salarial — liberação automática para o empregado&lt;/b&gt;&lt;br&gt;Fluxo acordado com o TL em 06/10/2026. As cores mostram o que já existe e o que falta." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Empregado solicita o adiantamento&lt;br&gt;POST /v3/anticipation/accounts/{agência}/{conta}/payroll/advances" style="rounded=1;arcSize=50;fontStyle=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="calc" value="API autentica, resolve o CPF do titular da conta&lt;br&gt;e calcula saldo, tarifa e valor liberado" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="210" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dry" value="dryRun?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="320" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sim" value="200 · simulação&lt;br&gt;nada é gravado" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="grava" value="Grava contrato, item e foto do pedido&lt;br&gt;contract_creditagreement (com a conta do pedido) · contract_loanposition · contract_salaryadvance (com a decisão automatic_release)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="auto" value="Liberação automática?&lt;br&gt;global &lt;b&gt;E&lt;/b&gt; empregador &lt;b&gt;E&lt;/b&gt; funcionário&lt;br&gt;(lidas na hora do pedido)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="555" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="flags" value="&lt;b&gt;As três flags&lt;/b&gt; (default: desligadas)&lt;br&gt;• Global (o banco): parameter_default.payroll_automatic_release&lt;br&gt;• Empregador: payroll_employer.is_automatic_release&lt;br&gt;• Funcionário: payroll_employee.is_automatic_release&lt;br&gt;Empregador e funcionário ligados pelo backoffice. Onboarding e planilha sempre entram desligados." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="420" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rip" value="Contrato e item nascem em&lt;br&gt;RELEASE_IN_PROGRESS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="commit" value="Commit da transação&lt;br&gt;200 para o empregado" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="820" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fila" value="&lt;b&gt;Fila nova&lt;/b&gt; anticipation-salary-advance-release (+ DLQ)&lt;br&gt;mensagem {type: ANTICIPATION_SALARY, contract_id}&lt;br&gt;enviada só depois do commit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="930" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="&lt;b&gt;Lambda nova&lt;/b&gt; anticipation-salary-advance-release&lt;br&gt;molde da credit-release · só age se o contrato está em RELEASE_IN_PROGRESS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1050" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="paga" value="Lançamentos iguais aos da nota, sem intermediários:&lt;br&gt;principal: conta de liquidação → conta do funcionário gravada no contrato (a escolhida no pedido)&lt;br&gt;tarifa: conta espelho → conta de recebimento&lt;br&gt;líquido na conta = pedido − tarifa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1170" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="Pagamento&lt;br&gt;concluído?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="1300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="falha" value="Lambda marca contrato e item em &lt;b&gt;ERROR&lt;/b&gt;&lt;br&gt;(status do PR #53 do repository)&lt;br&gt;continua consumindo o saldo do ciclo&lt;br&gt;não tenta de novo sozinha" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="1305" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="reproc" value="Operador vê o ERROR no backoffice e decide:&lt;br&gt;reprocessar (volta a RELEASE_IN_PROGRESS e publica na fila)&lt;br&gt;ou cancelar (só se nenhum lançamento foi executado)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="1170" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cancel2" value="CANCELLED&lt;br&gt;o valor volta ao saldo do ciclo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="1060" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="antecipado" value="Lambda marca contrato e item em ANTICIPATED&lt;br&gt;dinheiro na conta do empregado&lt;br&gt;(único lugar que marca ANTICIPATED)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1450" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="baixa" value="Empresa paga o salário&lt;br&gt;rotina do SAQ faz o split e dá a baixa → LIQUIDATED&lt;br&gt;(rotina futura)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1570" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pend" value="Contrato e item ficam em PENDING_RELEASE&lt;br&gt;aguardam o backoffice (como hoje)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="580" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="aprova" value="Operador&lt;br&gt;aprova?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="695" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cancel" value="Contrato e item em CANCELLED&lt;br&gt;o valor volta ao saldo do ciclo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="705" width="230" height="70" as="geometry" />
